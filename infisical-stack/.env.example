# BACKLOG #94 Phase 1 — Infisical .env placeholder file.
#
# DO NOT commit real secrets. This file ships as .env.example so operators can
# see the expected shape; bootstrap.sh's deploy_infisical_stack() generates a
# real .env at $INFRA_DIR/infisical-stack/.env on first run via openssl rand
# and writes the operator creds to ~/.hermes/secrets/infisical-operator.env
# with chmod 600.
#
# Required keys (per https://github.com/Infisical/infisical/blob/main/.env.example):
#   ENCRYPTION_KEY         32 hex chars   (16 bytes; encrypts the platform)
#   AUTH_SECRET            base64 random  (signs JWTs)
#   POSTGRES_USER          alphanumeric
#   POSTGRES_PASSWORD      random         (passed to postgres + DB_CONNECTION_URI)
#   POSTGRES_DB            alphanumeric   ("infisical")
#   DB_CONNECTION_URI      postgres://USER:PASSWORD@infisical-postgres:5432/DB
#   REDIS_URL              redis://:PASSWORD@infisical-redis:6379
#   SITE_URL               http://localhost:8090   (loopback only — operator uses Streamlit)
#
# POSTGRES_HOST / POSTGRES_PORT are NOT read by the backend; the backend
# constructs DB_CONNECTION_URI from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# + the literal "infisical-postgres" host on the docker network.

# --- Encryption / auth ---
ENCRYPTION_KEY=replace_with_32_hex_chars_openssl_rand_hex_16
AUTH_SECRET=replace_with_openssl_rand_base64_32

# --- Postgres ---
POSTGRES_USER=infisical
POSTGRES_PASSWORD=replace_with_openssl_rand_base64_32
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgres://infisical:REPLACE_WITH_POSTGRES_PASSWORD@infisical-postgres:5432/infisical

# --- Redis ---
REDIS_PASSWORD=replace_with_openssl_rand_base64_32
REDIS_URL=redis://:replace_with_redis_password@infisical-redis:6379

# --- Site URL ---
# Customer never reaches this UI; loopback binding in docker-compose.yml is the
# real gate. SITE_URL is what the backend uses to construct OAuth/email
# callback URLs (both disabled in this Phase 1 — see SMTP_* below).
SITE_URL=http://localhost:8090

# --- Mail (disabled in Phase 1; SMTP is OUT OF SCOPE per BACKLOG #94) ---
# Leave blank so the backend falls back to its no-SMTP mode. The admin
# bootstrap endpoint (POST /api/v1/admin/bootstrap) does NOT require SMTP —
# it provisions an admin user + org + machine identity directly.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Telemetry (off per Infisical default) ---
OTEL_TELEMETRY_COLLECTION_ENABLED=false
